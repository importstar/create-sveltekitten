{
	"name": "create-sveltekitten",
	"version": "2.4.0",
	"type": "module",
	"description": "Create a new SvelteKitten project (SSR or SPA)",
	"bin": {
		"create-sveltekitten": "./dist/index.js"
	},
	"files": [
		"dist",
		"templates"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsx src/index.ts",
		"test": "tsc && vitest run",
		"prepublishOnly": "pnpm build && node scripts/sync-template-gitignore.mjs"
	},
	"packageManager": "pnpm@12.10.1",
	"engines": {
		"node": ">=20.12.0"
	},
	"dependencies": {
		"@clack/prompts": "^1.8.1"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
