# Production image for adapter-node. The final process is the image's node user, not root.
# Build tools stay in the deps stage so the shipped image does not contain them.
ARG NODE_IMAGE=node:24.20.0-bookworm-slim
FROM ${NODE_IMAGE} AS build
ARG PNPM_VERSION=12.10.1
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
	&& rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
# pnpm 10+ skips dependency build scripts unless a config allows them.
RUN mkdir -p /root/.config/pnpm \
	&& printf 'dangerouslyAllowAllBuilds: true\n' > /root/.config/pnpm/config.yaml
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build

FROM ${NODE_IMAGE} AS deps
ARG PNPM_VERSION=12.10.1
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
	&& rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
RUN mkdir -p /root/.config/pnpm \
	&& printf 'dangerouslyAllowAllBuilds: true\n' > /root/.config/pnpm/config.yaml
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod

FROM ${NODE_IMAGE} AS prod
WORKDIR /app
COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/build ./build
COPY --from=build --chown=node:node /app/package.json ./package.json
USER node
ENV NODE_ENV=production \
	HOST=0.0.0.0 \
	PORT=3000 \
	PROTOCOL_HEADER=x-forwarded-proto \
	HOST_HEADER=x-forwarded-host \
	DATABASE_URL=/tmp/sqlite.db
EXPOSE 3000
CMD ["node", "build/index.js"]
